SEPKO_ENV=development
SEPKO_DATABASE_URL=postgresql+asyncpg://sepko:sepko@localhost:5433/sepko
# Produkcija: app user bez DDL (vidi deploy/postgres/harden.sql)
# SEPKO_DATABASE_URL=postgresql+asyncpg://sepko_app:sepko_app@localhost:5433/sepko
# SEPKO_DATABASE_ADMIN_URL=postgresql+psycopg://sepko:sepko@localhost:5433/sepko
SEPKO_SECRET_KEY=change-me-in-production
SEPKO_ALLOWED_HOSTS=127.0.0.1,localhost,proracun.me,www.proracun.me
SEPKO_PARTNER_MODE=mock
# Produkcija / sandbox Navira (EFI-shaped JSON):
# SEPKO_PARTNER_MODE=navira
# SEPKO_NAVIRA_BASE_URL=https://api.navira.example
# SEPKO_NAVIRA_API_KEY=
# Alias (isto kao NAVIRA_*):
# SEPKO_PARTNER_BASE_URL=
# SEPKO_PARTNER_API_KEY=
# Endpointi: POST {base}/v1/register-invoice , POST {base}/v1/register-cash-deposit
# Auth: Bearer / X-Api-Key. Odgovor: iic|ikof, fic|jikr, qrUrl (opciono).

# Zaštita od skenera / botova (podrazumijevano uključeno)
# SEPKO_BLOCK_PROBES=true
# SEPKO_GLOBAL_RATE_LIMIT=true
# Tajni token za dnevni cron mjesečnih faktura + profaktura licence:
# SEPKO_CRON_SECRET=promijeni-me
# Poziv: GET /cron/raspored?token=...  (fakture tenanata + licence)
#        GET /cron/licence?token=...   (samo istekle / ističu licence)

# Platform admin (/admin) — super@sepko.me
# U developmentu default lozinka je sepko-super ako ovo nije setovano.
# SEPKO_SUPERADMIN_PASSWORD=sepko-super

# PKCS#12 sertifikati (KPM) — {SEPKO_CERT_DIR}/{tenant_slug}.p12
# SEPKO_CERT_DIR=
# SEPKO_CERT_PASSWORD=
# SEPKO_PKCS11_MODULE=
# SEPKO_PKCS11_PIN=
# Opciono: HashiCorp Vault
# SEPKO_VAULT_ADDR=http://127.0.0.1:8200

# Backup → OneDrive (docker-compose.backup.yml)
# SEPKO_BACKUP_ONEDRIVE_DIR=E:/onedrive/SepkoBackups
# SEPKO_BACKUP_RETENTION_DAYS=14
# SEPKO_BACKUP_INTERVAL_HOURS=24
# SEPKO_BACKUP_PGUSER=sepko
# SEPKO_BACKUP_PGPASSWORD=sepko
# SEPKO_BACKUP_PGDATABASE=sepko
# SEPKO_BACKUP_INCLUDE_UPLOADS=1
# SEPKO_BACKUP_INCLUDE_CERTS=1

# Mail — izvodi po firmi (IMAP u Podešavanja → Mail; port se auto-detektuje)
# IMAP_HOST=fusion.mxrouting.net
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# MAIL_SINCE_DATE=2026-01-01
# MAIL_IZVOD_SUBJECTS=Hipotekarna banka - Izvod racuna

# Platform mail — Resend (licence + kartice/fakture svih firmi; Reply-To = IMAP user firme)
# Izdavalac: PROSTUDIO.ME DOO (prostudio.me)
# RESEND_API_KEY=
# RESEND_FROM=PROSTUDIO.ME DOO <finansije@prostudio.me>
# SMTP_* rezervа samo ako Resend nije podešen
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=ProRačun
# SEPKO_BILLING_NAME=PROSTUDIO.ME DOO
# SEPKO_BILLING_EMAIL=finansije@prostudio.me
# SEPKO_BILLING_PIB=03452668
# SEPKO_BILLING_ADDRESS=Bulevar 21. maj 24, Podgorica, Crna Gora
# SEPKO_BILLING_PHONE=+382 67 254 256
# SEPKO_BILLING_IBAN=
# SEPKO_BILLING_SIGNER_NAME=
# SEPKO_LICENSE_MONTHLY_PRICE=15
# SEPKO_LICENSE_ITEM_NAME=ProRačun Basic WEB
